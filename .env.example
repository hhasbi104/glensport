DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sport_court_booking
# PostgreSQL CA certificate PEM; escape newlines as \n on one line locally.
DB_SSL_CA=

# Akun admin untuk npm run seed:admin. Gunakan password acak minimal 12 karakter.
ADMIN_EMAIL=admin@courtly.local
ADMIN_PASSWORD=ubah-password-admin-ini

# Token rahasia untuk cookie sesi dan integrasi admin berbasis API key.
SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
ADMIN_API_KEY=ganti-dengan-token-rahasia

# WhatsApp Cloud API untuk pesan konfirmasi booking.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=booking_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_GRAPH_API_VERSION=
